/* ✨ DOLARHUNTER — Bright Girly Scrollbar & Base Styles */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: #fce7f3; /* soft pink rose */
}

::-webkit-scrollbar-thumb {
  background: #f9a8d4; /* bubblegum pink */
  border-radius: 3px;
}

::-webkit-scrollbar-thumb:hover {
  background: #ec4899; /* hot pink */
}

body {
  user-select: none;
  background: #fdf0f7; /* blush white */
  accent-color: #ec4899; /* pink focus rings on inputs */
}

/* ✨ Optional: pink selection highlight */
::selection {
  background: #f9a8d4;
  color: #831843;
}
.logo {
    display: flex;
    align-items: center;
    height: 42px;
}

.logo img {
    height: 16px;
    width: auto;
    max-width: 75px;
    object-fit: contain;
    display: block;
}

/* DOLARHUNTER startup screen */
#dolarhunter-splash {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    background: #050b12;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2147483647;
}

#dolarhunter-splash img {
    width: 100px;
    height: auto;
    max-width: 25vw;
    object-fit: contain;
}